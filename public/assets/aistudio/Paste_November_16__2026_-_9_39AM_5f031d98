<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Golf Discovery Studio - Mobile Flight Simulator</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;600;700&display=swap');
        
        body {
            font-family: 'Inter', sans-serif;
            background-color: #0B0F17;
            color: #F3F4F6;
            touch-action: manipulation;
            -webkit-tap-highlight-color: transparent;
        }

        .font-mono-num {
            font-family: 'JetBrains Mono', monospace;
        }

        /* Glassmorphism utility */
        .glass-panel {
            background: rgba(18, 26, 41, 0.75);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }

        .glass-panel-interactive {
            background: rgba(22, 32, 50, 0.85);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(0, 230, 153, 0.2);
            transition: all 0.2s ease;
        }

        .glass-panel-interactive:active {
            border-color: rgba(0, 230, 153, 0.6);
            transform: scale(0.99);
        }

        /* Custom range slider thumb styling */
        input[type=range] {
            -webkit-appearance: none;
            width: 100%;
            background: rgba(255, 255, 255, 0.1);
            height: 6px;
            border-radius: 4px;
            outline: none;
        }

        input[type=range]::-webkit-slider-thumb {
            -webkit-appearance: none;
            appearance: none;
            width: 20px;
            height: 20px;
            border-radius: 50%;
            background: #00E699;
            box-shadow: 0 0 10px rgba(0, 230, 153, 0.6);
            cursor: pointer;
            border: 2px solid #0B0F17;
        }

        input[type=range]::-moz-range-thumb {
            width: 20px;
            height: 20px;
            border-radius: 50%;
            background: #00E699;
            box-shadow: 0 0 10px rgba(0, 230, 153, 0.6);
            cursor: pointer;
            border: 2px solid #0B0F17;
        }

        /* Pulse glowing animation */
        @keyframes neonPulse {
            0%, 100% { box-shadow: 0 0 15px rgba(0, 230, 153, 0.4); }
            50% { box-shadow: 0 0 25px rgba(0, 230, 153, 0.8); }
        }

        .neon-glow-button {
            animation: neonPulse 2.5s infinite;
        }

        /* Hide scrollbars for slick mobile horizontal view */
        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between overflow-x-hidden pb-10">

    <!-- TOP NAVBAR -->
    <header class="glass-panel sticky top-0 z-50 px-4 py-3 flex items-center justify-between border-b border-white/10">
        <div class="flex items-center space-x-2">
            <div class="w-8 h-8 rounded-lg bg-gradient-to-tr from-emerald-500 to-cyan-400 flex items-center justify-center text-slate-950 font-black text-lg shadow-lg shadow-emerald-500/20">
                G
            </div>
            <div>
                <h1 class="text-xs font-bold tracking-tight text-white flex items-center gap-1.5">
                    GOLF DISCOVERY STUDIO
                    <span class="text-[9px] font-medium bg-emerald-500/20 text-emerald-400 px-1 py-0.5 rounded border border-emerald-500/30">ITR-2</span>
                </h1>
                <p class="text-[10px] text-gray-400">Mobile Ball Flight Physics &amp; Telemetry</p>
            </div>
        </div>

        <div class="flex items-center space-x-2">
            <button id="soundToggleBtn" onclick="toggleAudio()" class="p-2 rounded-lg bg-slate-800/80 text-emerald-400 hover:bg-slate-700 transition-colors border border-emerald-500/20 flex items-center gap-1 text-xs font-semibold">
                <i data-lucide="volume-2" class="w-4 h-4"></i>
                <span id="soundStatus" class="hidden sm:inline">Sound ON</span>
            </button>
            <button onclick="resetAllData()" title="Reset All" class="p-2 rounded-lg bg-slate-800/80 text-slate-300 hover:text-white hover:bg-slate-700 transition-colors border border-white/10">
                <i data-lucide="rotate-ccw" class="w-4 h-4"></i>
            </button>
        </div>
    </header>

    <!-- MAIN CONTAINER -->
    <main class="w-full max-w-md mx-auto px-3 pt-3 flex-1 flex flex-col gap-3">

        <!-- CANVAS DISPLAY SECTION -->
        <div class="relative w-full rounded-2xl glass-panel overflow-hidden border border-emerald-500/20 shadow-2xl flex flex-col">
            <!-- View Mode Selector Bar & Live Status -->
            <div class="px-3 py-2 bg-slate-950/60 border-b border-white/5 flex items-center justify-between">
                <div class="flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
                    <span id="simStateLabel" class="text-[11px] font-semibold text-emerald-400 tracking-wide uppercase">Ready for Swing</span>
                </div>
                
                <div class="flex items-center bg-slate-900 p-0.5 rounded-lg border border-white/10">
                    <button id="btnViewSide" onclick="setViewMode('side')" class="px-2.5 py-1 text-xs font-medium rounded-md bg-emerald-500 text-slate-950 transition-all">
                        Side View
                    </button>
                    <button id="btnViewTop" onclick="setViewMode('top')" class="px-2.5 py-1 text-xs font-medium rounded-md text-slate-400 hover:text-white transition-all">
                        Top-Down Tracer
                    </button>
                </div>
            </div>

            <!-- Canvas Wrapper -->
            <div class="relative w-full h-[220px] bg-gradient-to-b from-slate-950 via-slate-900 to-slate-950">
                <canvas id="flightCanvas" class="w-full h-full block cursor-crosshair"></canvas>
                
                <!-- Overlay HUD Stats during animation -->
                <div id="hudOverlay" class="absolute top-2 left-2 flex gap-1.5 pointer-events-none text-[10px] font-mono-num">
                    <div class="bg-slate-950/80 border border-emerald-500/30 px-1.5 py-0.5 rounded text-emerald-400">
                        Dist: <span id="hudDistance">0.0</span> yds
                    </div>
                    <div class="bg-slate-950/80 border border-cyan-500/30 px-1.5 py-0.5 rounded text-cyan-400">
                        H: <span id="hudHeight">0.0</span> yds
                    </div>
                    <div class="bg-slate-950/80 border border-purple-500/30 px-1.5 py-0.5 rounded text-purple-300">
                        T: <span id="hudTime">0.0</span>s
                    </div>
                </div>

                <!-- Canvas Visual Legend -->
                <div class="absolute bottom-2 right-2 pointer-events-none text-[9px] text-slate-400 bg-slate-950/60 px-2 py-0.5 rounded border border-white/5">
                    <span id="canvasLegendText">Grid: 50yd / 20yd (Side Elevation)</span>
                </div>
            </div>
        </div>

        <!-- LAUNCH MONITOR DISPLAY GRID -->
        <div class="grid grid-cols-2 gap-2">
            <!-- Club Speed -->
            <div class="glass-panel p-2.5 rounded-xl border border-white/5">
                <span class="text-[10px] font-semibold uppercase tracking-wider text-slate-400 block">Club Speed</span>
                <div class="flex items-baseline gap-1 mt-0.5">
                    <span id="metricClubSpeed" class="text-xl font-extrabold font-mono-num text-white">105.0</span>
                    <span class="text-[10px] text-slate-400">mph</span>
                </div>
            </div>

            <!-- Ball Speed -->
            <div class="glass-panel p-2.5 rounded-xl border border-white/5">
                <span class="text-[10px] font-semibold uppercase tracking-wider text-slate-400 block">Ball Speed</span>
                <div class="flex items-baseline gap-1 mt-0.5">
                    <span id="metricBallSpeed" class="text-xl font-extrabold font-mono-num text-emerald-400">155.4</span>
                    <span class="text-[10px] text-slate-400">mph</span>
                </div>
            </div>

            <!-- Smash Factor -->
            <div class="glass-panel p-2.5 rounded-xl border border-white/5">
                <span class="text-[10px] font-semibold uppercase tracking-wider text-slate-400 block">Smash Factor</span>
                <div class="flex items-baseline gap-1 mt-0.5">
                    <span id="metricSmash" class="text-xl font-extrabold font-mono-num text-cyan-400">1.48</span>
